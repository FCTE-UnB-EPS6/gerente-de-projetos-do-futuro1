# Copie para .env e preencha. NUNCA faça commit do .env.
GPF_ENV=development
GPF_LOG_LEVEL=INFO

# Provedor de LLM para os agentes (opcional na fase inicial)
ANTHROPIC_API_KEY=

# Modelos de risco preditivo (gerados com `gpf-train`)
GPF_MODEL_PATH=/models/gpf-risk.joblib
GPF_MODEL_SHA256=
GPF_RISK_THRESHOLD=0.5

# Se definido, as rotas /ml/* exigem "Authorization: Bearer <token>".
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
GPF_API_TOKEN=
