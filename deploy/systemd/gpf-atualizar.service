[Unit]
Description=GPF - atualiza homologação e produção a partir do GHCR
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=gpf
Group=docker
WorkingDirectory=/opt/gpf
Environment=DOCKER_CONFIG=/opt/gpf/.docker
ExecStart=/opt/gpf/atualizar.sh
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/gpf
PrivateTmp=true
