# Copie para /srv/gpf/.env no DATEN e proteja: chmod 600 .env
# NUNCA faça commit do .env.

# Tag da imagem no GHCR. Prefira o SHA do commit (reprodutível) a "latest".
GPF_IMAGE_TAG=latest
GPF_LOG_LEVEL=INFO

# Hash do modelo em /srv/gpf/models/gpf-risk.joblib (o publicar-modelo.sh preenche).
GPF_MODEL_SHA256=
GPF_RISK_THRESHOLD=0.5

# Token das rotas /ml/*. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GPF_API_TOKEN=

# Opcional, para os futuros agentes com LLM
ANTHROPIC_API_KEY=
